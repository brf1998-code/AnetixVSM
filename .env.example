# Local work only. The live instance's variables live in Railway (CLAUDE.md, "Live instance env vars").
DATABASE_URL=postgres://sos:sos@localhost:5432/sos
ANTHROPIC_API_KEY=
SESSION_SECRET=change-me-to-a-long-random-string
# Required before any authenticator can be set up, and never changed afterwards: authenticator secrets, ERP logins
# and the per-company database passwords are all under it (openssl rand -hex 32).
SOS_CONNECTION_KEY=
# Opens admin until the first admin account has an authenticator; then take it out.
SOS_ADMIN_PASSWORD=
# Optional: open with no sign-in at all, every request an admin. Local work only; a hosted deployment ignores it.
SOS_OPEN=0
# Fake agent runs (no API calls) for local work and the test suites.
SOS_FAKE_AGENT=1
PORT=3000
